generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("CUSTOMER") // CUSTOMER | RESTAURANT | ADMIN
  createdAt DateTime @default(now())

  restaurant          Restaurant?
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
}

model Restaurant {
  id            String   @id @default(cuid())
  owner         User     @relation(fields: [ownerId], references: [id])
  ownerId       String   @unique
  name          String
  description   String?
  address       String
  phone         String
  logoUrl       String?
  coverUrl      String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  deliveryTypes String[]
  openHours     String?
  createdAt     DateTime @default(now())

  categories     Category[]
  paymentMethods PaymentMethod[]
  orders         Order[]
}

model Category {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  name         String
  order        Int        @default(0)
  items        MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  name        String
  description String?
  price       Float
  imageUrl    String?
  available   Boolean  @default(true)
  order       Int      @default(0)
  orderItems  OrderItem[]
}

model PaymentMethod {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  type         String     // QR | TRANSFER | CASH
  label        String
  details      String?
  qrImageUrl   String?
  active       Boolean    @default(true)
}

model Order {
  id           String     @id @default(cuid())
  customer     User       @relation(fields: [customerId], references: [id])
  customerId   String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  items        OrderItem[]
  status       String     @default("PENDING")
  deliveryType String
  address      String?
  notes        String?
  total        Float
  proofUrl     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  name       String
  price      Float
  quantity   Int
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
